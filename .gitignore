# Dependencies
node_modules/

# Production build (generated on Netlify via `npm run build`)
/build

# Environment and secrets
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Test output
/coverage

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS
.DS_Store
Thumbs.db

# IDE / editor (local)
.idea/
.vscode/
*.swp
*.swo

# Cursor (local tooling)
.cursor/
.cursorrules
.cursorignore

# Tooling cache
.eslintcache
*.tsbuildinfo
.githooks/
.venv-locale/

# Storybook
storybook-static/

# Netlify local CLI folder
.netlify/

# Internal docs and drafts (not used by the site build). Contain private
# feedback notes and internal tracker links.
docs/

# Personal content for the unlisted /story and /prayer pages: text, photos and
# videos. Loaded on demand from here (see src/data/private-content.ts); a build
# without these files still works and those pages say they are not part of
# the build.
src/content/private/*
!src/content/private/.gitkeep

# Local archive of retired assets and drafts (originals the site no longer
# uses). Kept on disk for reference; never published.
local-archive/
src/locales/


